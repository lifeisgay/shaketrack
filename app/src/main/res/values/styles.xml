<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-wide dark theme (dialogs, spinners and system bars follow it) -->
    <style name="Theme.ShakeTrack" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/st_bg</item>
        <item name="android:colorBackground">@color/st_bg</item>
        <item name="android:statusBarColor">@color/st_bg</item>
        <item name="android:navigationBarColor">@color/st_surface</item>
        <item name="android:colorAccent">@color/st_accent</item>
        <item name="android:alertDialogTheme">@style/Theme.ShakeTrack.Alert</item>
    </style>

    <style name="Theme.ShakeTrack.Alert" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/st_accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <!-- Quick-add bottom sheet -->
    <style name="Theme.ExpenseTracker.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/st_accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
